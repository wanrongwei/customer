<?xml version="1.0" encoding="UTF-8"?>
<configuration scan="true" scanPeriod="60 seconds">
    <springProperty name="APP_NAME" scope="system" source="spring.application.name" />
    <springProperty name="PORT" scope="system" source="server.port" />
    <springProperty name="LOG_PATH" scope="system" source="logging.file.path" defaultValue="${HOME}/logs" />
    
    <property name="LOG_PATTERN" value="%d{yyyy-MM-dd HH:mm:ss.SSS} [${APP_NAME} ${PORT}] [%tid] [%thread] [%level] %logger{50} [%file:%line] %msg%n" />
    <property name="SW_LOG_PATTERN" value="%d{yyyy-MM-dd HH:mm:ss.SSS} [${APP_NAME} ${PORT}] [%X{tid}] [%thread] [%level] %logger{50} [%file:%line] %msg%n" />
    <property name="LOG_DIR" value="${LOG_PATH}/${APP_NAME}" />
    
    <!-- Console Appender -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder class="ch.qos.logback.core.encoder.LayoutWrappingEncoder">
            <layout class="org.apache.skywalking.apm.toolkit.log.logback.v1.x.TraceIdPatternLogbackLayout">
                <Pattern>${LOG_PATTERN}</Pattern>
            </layout>
        </encoder>
    </appender>
    
	<!-- gRPC 报告器可以将收集到的日志转发到 SkyWalking OAP,默认不开启 -->
    <appender name="grpc-log" class="org.apache.skywalking.apm.toolkit.log.logback.v1.x.log.GRPCLogClientAppender">
        <encoder class="ch.qos.logback.core.encoder.LayoutWrappingEncoder">
            <layout class="org.apache.skywalking.apm.toolkit.log.logback.v1.x.mdc.TraceIdMDCPatternLogbackLayout">
            	<pattern>${SW_LOG_PATTERN}</pattern>
            </layout>
        </encoder>
    </appender>
    
    <!-- INFO级别日志文件Appender -->
    <appender name="FILE_ALL" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_DIR}/${APP_NAME}.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_DIR}/%d{yyyy-MM-dd, aux}/${APP_NAME}_%d{yyyy-MM-dd}.%i.log</fileNamePattern>
            <MaxHistory>3</MaxHistory>
            <CleanHistoryOnStart>true</CleanHistoryOnStart>
            <MaxFileSize>100MB</MaxFileSize>
            <TotalSizeCap>10GB</TotalSizeCap>
        </rollingPolicy>
        <encoder>
            <pattern>${LOG_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>
    
    <!-- ERROR级别日志文件Appender -->
    <appender name="FILE_ERROR" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_DIR}/${APP_NAME}_error.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_DIR}/%d{yyyy-MM-dd, aux}/${APP_NAME}_%d{yyyy-MM-dd}_error.%i.log</fileNamePattern>
            <MaxHistory>3</MaxHistory>
            <CleanHistoryOnStart>true</CleanHistoryOnStart>
            <MaxFileSize>100MB</MaxFileSize>
            <TotalSizeCap>3GB</TotalSizeCap>
        </rollingPolicy>
        <encoder>
            <pattern>${LOG_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
        <filter class="ch.qos.logback.classic.filter.ThresholdFilter">
            <level>ERROR</level>
        </filter>
    </appender>
    
    <!-- 全量 JSON 日志 -->
    <conversionRule conversionWord="tid" converterClass="org.apache.skywalking.apm.toolkit.log.logback.v1.x.LogbackPatternConverter"/>
    <appender name="FILE_ALL_JSON" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_DIR}/${APP_NAME}.json</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_DIR}/%d{yyyy-MM-dd, aux}/${APP_NAME}_%d{yyyy-MM-dd}.%i.json</fileNamePattern>
            <maxHistory>3</maxHistory>
            <cleanHistoryOnStart>true</cleanHistoryOnStart>
            <maxFileSize>100MB</maxFileSize>
            <totalSizeCap>5GB</totalSizeCap>
        </rollingPolicy>
        
        <!-- 使用 LogstashEncoder 输出 JSON 格式 -->
        <encoder class="net.logstash.logback.encoder.LoggingEventCompositeJsonEncoder">
            <providers>
                <!-- 时间 -->
                <timestamp>
                    <fieldName>@timestamp</fieldName>
                    <pattern>yyyy-MM-dd'T'HH:mm:ss.SSSXXX</pattern>
                </timestamp>

                <!-- 日志级别 -->
                <logLevel>
                    <fieldName>log.level</fieldName>
                </logLevel>

                <!-- message -->
                <message/>

                <!-- logger -->
                <loggerName>
                    <fieldName>log.logger</fieldName>
                </loggerName>

                <!-- 线程 -->
                <threadName>
                    <fieldName>process.thread.name</fieldName>
                </threadName>

                <!-- 调用位置 -->
                <callerData>
                    <classFieldName>log.origin.class</classFieldName>
                    <methodFieldName>log.origin.function</methodFieldName>
                    <fileFieldName>log.origin.file.name</fileFieldName>
                    <lineFieldName>log.origin.file.line</lineFieldName>
                </callerData>

                <!-- stacktrace -->
                <stackTrace>
                    <fieldName>error.stack_trace</fieldName>
                </stackTrace>

	            <pattern>
	                <pattern>
	                    {
	                    	"tid": "%tid",
	                      	"service.name": "${APP_NAME}",
	                      	"service.port": "${PORT}"
	                    }
	                </pattern>
	            </pattern>
            </providers>
        </encoder>
    </appender>
    
    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="FILE_ALL"/>
        <appender-ref ref="FILE_ERROR"/>
        <appender-ref ref="FILE_ALL_JSON"/>
    </root>
</configuration>