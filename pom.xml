<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<groupId>com.aie</groupId>
	<artifactId>crm-customer</artifactId>
	<version>${revision}</version>
	<packaging>pom</packaging>
	<name>CRM-core</name>
	<properties>
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
		<project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
		<java.version>17</java.version>
		<maven.compiler.source>17</maven.compiler.source>
		<maven.compiler.target>17</maven.compiler.target>
		<maven-compiler-plugin.version>3.13.0</maven-compiler-plugin.version>
		<versions-maven-plugin.version>2.18.0</versions-maven-plugin.version>
		<crm-dependence.version>1.1.8-SNAPSHOT</crm-dependence.version>
		<appframe.version>2025.1-SNAPSHOT</appframe.version>
		<revision>0.0.1-SNAPSHOT</revision>
	</properties>
	<dependencyManagement>
		<dependencies>
			<dependency>
				<groupId>com.aie</groupId>
				<artifactId>CRM-dependence</artifactId>
				<version>${crm-dependence.version}</version>
				<type>pom</type>
				<scope>import</scope>
			</dependency>
			<dependency>
				<groupId>com.aie</groupId>
				<artifactId>bss-crm-bom</artifactId>
				<version>${crm-dependence.version}</version>
				<type>pom</type>
				<scope>import</scope>
			</dependency>
		</dependencies>
	</dependencyManagement>
	<build>
		<defaultGoal>compile</defaultGoal>
		<plugins>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<version>${maven-compiler-plugin.version}</version>
				<artifactId>maven-compiler-plugin</artifactId>
				<configuration>
					<encoding>${project.build.sourceEncoding}</encoding>
					<source>${maven.compiler.source}</source>
					<target>${maven.compiler.target}</target>
					<!--
					  Force annotation processors to run (Lombok getters/@Slf4j, etc).
					  Without this, compilation may fail with "cannot find symbol" for generated methods/fields.
					-->
					<annotationProcessorPaths>
						<path>
							<groupId>org.projectlombok</groupId>
							<artifactId>lombok</artifactId>
							<version>1.18.42</version>
						</path>
					</annotationProcessorPaths>
					<!--<compilerArgs>
						<arg>-parameters</arg>
					</compilerArgs>-->
				</configuration>
			</plugin>
			<plugin>
				<groupId>org.codehaus.mojo</groupId>
				<artifactId>versions-maven-plugin</artifactId>
			</plugin>
			<plugin>
		      <groupId>org.codehaus.mojo</groupId>
		      <artifactId>flatten-maven-plugin</artifactId>
		      <version>1.3.0</version>
		      <configuration>
		        <updatePomFile>true</updatePomFile> <!-- 可选：是否更新原POM -->
		      </configuration>
		      <executions>
		        <execution>
		          <id>flatten</id>
		          <phase>process-resources</phase>
		          <goals>
		            <goal>flatten</goal>
		          </goals>
		        </execution>
		      </executions>
		    </plugin>
		</plugins>
		<pluginManagement>
			<plugins>
				<plugin>
					<groupId>org.codehaus.mojo</groupId>
					<artifactId>versions-maven-plugin</artifactId>
					<version>${versions-maven-plugin.version}</version>
				</plugin>
			</plugins>
		</pluginManagement>
	</build>
	<modules>
		<module>customer-core</module>
		<module>customer-starter</module>
	</modules>
	<dependencies>
		<dependency>
			<groupId>other</groupId>
			<artifactId>process_class</artifactId>
			<version>1.0</version>
		</dependency>
	</dependencies>
</project>
